# Production environment for the backend. Copy to `backend/.env.production` and
# fill in every value marked REQUIRED.
#
#   cp backend/.env.production.example backend/.env.production
#
# `.env*` is gitignored, so the real file never enters the repository. Generate
# secrets with the commands shown next to each one — do not reuse the dev values
# in `backend/.env`, and do not invent short ones by hand.

# --- Environment ---------------------------------------------------------
# `production` turns off the development credit-metering bypass, so real searches
# debit real credits. It also disables the interactive API docs (see
# ENABLE_API_DOCS) and is what `settings.is_production` reads.
ENVIRONMENT=production

# Never true on a public host: DEBUG returns tracebacks in HTTP responses, which
# leak file paths, SQL and configuration.
DEBUG=false

# --- Secrets (REQUIRED) --------------------------------------------------
# Signs access and refresh tokens. Anyone holding this can mint a token for any
# user, so it must be unique per deployment.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Encrypts provider credentials stored through the API Manager (Fernet).
# Losing it makes every stored key unreadable; changing it without keeping the
# old value first makes them undecryptable. Comma-separate to rotate: put the new
# key first, keep the previous one second until re-encryption has run.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# --- Database and cache (REQUIRED) --------------------------------------
# Must match POSTGRES_PASSWORD / REDIS_PASSWORD in the shell environment that
# runs docker compose — the same values are given to the postgres and redis
# containers there.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=leadmaster
POSTGRES_PASSWORD=
POSTGRES_DB=leadmaster

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Public URLs (REQUIRED) ---------------------------------------------
# Your domain, no trailing slash. Used in verification and password-reset emails,
# so a wrong value sends users to a dead link.
FRONTEND_URL=https://your-domain.com

# Browser origins allowed to call the API. With the Caddy topology the app and API
# share one origin and no cross-origin request is made at all, but the value is
# still checked, so list the real domain rather than "*".
CORS_ORIGINS=https://your-domain.com

# --- Hardening -----------------------------------------------------------
# Must stay false in production. True lets the website scanner fetch private
# addresses (169.254.169.254, 10.0.0.0/8, localhost), turning it into an SSRF
# tool against your own infrastructure and the host's cloud metadata service.
SCANNER_ALLOW_PRIVATE_NETWORKS=false

# Interactive docs (/docs, /redoc, /openapi.json). Unset defaults to off in
# production because they publish the full API surface and every schema. Set to
# true only if you want them public.
# ENABLE_API_DOCS=false

# --- Provider API keys (all optional) -----------------------------------
# Each provider is skipped when its credential is absent — searches still run
# with whatever is configured, and no credits are spent on a provider that cannot
# be called. These can also be set per workspace in the API Manager UI, which
# stores them encrypted in the database and takes precedence over these values.
#
# OpenStreetMap and Overpass need no credentials and work out of the box.
GOOGLE_MAPS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
GEOAPIFY_API_KEY=
BING_SEARCH_API_KEY=
OPENAI_API_KEY=

# Defaults are correct; override only to use a mirror or a self-hosted instance.
# OSM_USER_AGENT=LeadMasterAI/1.0
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Email (optional, but password reset and verification need it) ------
# Without SMTP, verification and reset emails are only written to the log, so
# nobody but you can complete a signup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Billing (optional) --------------------------------------------------
# Use live keys only when you intend to take real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
