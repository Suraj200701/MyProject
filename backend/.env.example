# Copy this file to .env and fill in real values before running.
# Nothing in this file is a working secret.

# --- App ---
APP_NAME=LeadMaster AI API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=leadmaster
POSTGRES_PASSWORD=leadmaster
POSTGRES_DB=leadmaster
DB_ECHO=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_dev_only_insecure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Google Maps (https://console.cloud.google.com/google/maps-apis) ---
GOOGLE_MAPS_API_KEY=

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
# Set RESEND_API_KEY in production. Most PaaS hosts (Render included) block
# outbound SMTP ports, so smtp.gmail.com times out there no matter how correct
# the credentials are; Resend goes over HTTPS. EMAIL_FROM must be on a domain
# verified in the Resend account. https://resend.com/api-keys
RESEND_API_KEY=

# --- Email / SMTP (local dev: Mailhog, Mailpit — ignored if RESEND_API_KEY is set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@leadmaster.ai
EMAIL_FROM_NAME=LeadMaster AI

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Frontend origin (used in email links, OAuth redirects, CORS) ---
FRONTEND_URL=http://localhost:3000

# --- Field encryption (provider credentials / API keys at rest) ---
# Required before any provider credential can be stored.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: comma-separated, NEWEST FIRST. All keys are tried on decrypt.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# --- Credit metering ---
# Master switch. false = nothing is ever debited, in any environment.
CREDIT_METERING_ENABLED=true
# Skip metering while ENVIRONMENT=development, so local work is not blocked by
# a 100-credit Free plan. Has no effect in staging or production — both
# conditions must hold. Set to false to exercise the real metering path locally.
CREDIT_METERING_DISABLED_IN_DEVELOPMENT=true
DEFAULT_SEARCH_CREDIT_COST_PER_RESULT=1
SCANNER_CREDITS_PER_SCAN=1
# Cost ceiling per provider per search: this many results are reserved up front
# at DEFAULT_SEARCH_CREDIT_COST_PER_RESULT each, and the unused part is refunded.
# Keep it well under the smallest plan's credit grant (Free = 100) or every
# search on that plan will be refused with 402 before it starts.
SEARCH_MAX_RESULTS_PER_PROVIDER=5

# --- Website scanner: outbound fetch safety (SSRF hardening) ---
SCANNER_TIMEOUT_SECONDS=15
SCANNER_CONNECT_TIMEOUT_SECONDS=5
SCANNER_MAX_PAGE_BYTES=5242880
SCANNER_MAX_REDIRECTS=5
SCANNER_USER_AGENT=LeadMasterBot/1.0 (+https://leadmaster.ai/bot)
SCANNER_ALLOWED_PORTS=80,443
# MUST stay false in production — true permits private/loopback scan targets.
SCANNER_ALLOW_PRIVATE_NETWORKS=false
SCANNER_BLOCKED_DOMAINS=

# --- Lead provider APIs ---
# Google Places (New) — same key as GOOGLE_MAPS_API_KEY above; enable
# "Places API (New)" on it in Google Cloud Console.
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
# NOTE: standalone Bing Search v7 was retired for NEW Azure subscriptions in
# Aug 2025. Works only with a pre-existing resource; endpoint is overridable.
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# --- Geoapify (OpenStreetMap places + geocoding) ---
# Free tier available: https://myprojects.geoapify.com/
# NOTE the base URL is treated as an ORIGIN. Geoapify splits its API across two
# version prefixes — Places is /v2, geocoding is /v1 — so any trailing /v1 or /v2
# here is stripped and the right version is appended per endpoint. Setting
# https://api.geoapify.com/v2 works, but so does the bare origin.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
# Radius searched around a geocoded location. Geoapify Places requires a spatial
# filter, so keyword+location becomes "geocode the place, search this far around it".
GEOAPIFY_SEARCH_RADIUS_METERS=20000

# --- OpenStreetMap / Overpass (no API key required) ---
# Nominatim REQUIRES an identifying User-Agent and rejects requests without one.
OSM_USER_AGENT=LeadMasterAI/1.0
OVERPASS_URL=https://overpass-api.de/api/interpreter

PROVIDER_TIMEOUT_SECONDS=12

# --- AI lead scoring (falls back to a real signal-based scorer when unset) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_SCORING_MODEL=gpt-4o-mini
AI_SCORING_ENABLED=true
AI_SCORING_MAX_LEADS_PER_SEARCH=25

# --- Website crawl (Company Website Search + scanner) ---
WEBSITE_CRAWL_MAX_PAGES=3

# --- Lead deduplication ---
DEDUP_ENABLED=true
DEDUP_NAME_SIMILARITY_THRESHOLD=0.88

# --- CSV import ---
CSV_IMPORT_MAX_ROWS=5000
# --- Export Center ---
# Hard ceiling on rows per export (bounds memory, file size, and bulk extraction).
EXPORT_MAX_ROWS=50000
# Generated file is rejected above this size.
EXPORT_MAX_FILE_SIZE_MB=50
# At/above this row count the export goes to Celery and the API returns 202.
# Requires a running worker: celery -A notifications.celery_app worker
EXPORT_ASYNC_ROW_THRESHOLD=5000
# Exports are disposable; after this they are marked expired and their bytes deleted
# by the exports.purge_expired_exports beat task.
EXPORT_RETENTION_HOURS=72
# Per-user budget on export creation.
EXPORT_RATE_LIMIT_PER_HOUR=30
# Lifetime of a signed download token (it travels in a URL, so keep it short).
EXPORT_DOWNLOAD_TOKEN_TTL_SECONDS=300
