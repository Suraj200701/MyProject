# --- Frontend environment ---
# Copy to .env.local for local development. Only NEXT_PUBLIC_* variables are
# readable from browser code.

# Origin of the FastAPI backend. NO trailing slash and NO /api/v1 suffix —
# the API modules append the versioned path themselves, so a value ending in
# /api/v1 would produce /api/v1/api/v1/... and 404.
#
# Set it to the EMPTY STRING for same-origin, where a reverse proxy serves the
# app and the API on one hostname. That is what the production compose file
# builds with, so the image carries no hostname and runs on any domain.
#
# Note this is inlined at build time, not read at runtime: changing it means
# rebuilding the frontend, not restarting it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: public site URL, used for absolute links in emails/OAuth returns.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
